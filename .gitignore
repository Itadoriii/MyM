node_modules
.env

# Volcados de base de datos: contienen correos, teléfonos, RUT y hashes de
# contraseñas de clientes reales. Nunca deben subirse a un repositorio. Las
# migraciones sí se versionan: son el esquema, no datos de clientes.
*.sql
!migrations/*.sql
*.sql.gz
*.dump

# Credenciales y certificados
*.pem
*.key
*.p12
*.pfx
.env.*
!.env.example

# Informes de logs: traen IPs y datos de intentos, no deben subirse.
informe*.txt
informe*.log
logs-seguridad*.txt
